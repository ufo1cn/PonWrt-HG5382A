diff --git a/feeds/pon_userspace/luci-app-blueaudio/Makefile b/feeds/pon_userspace/luci-app-blueaudio/Makefile
new file mode 100644
index 0000000..950080c
--- /dev/null
+++ b/feeds/pon_userspace/luci-app-blueaudio/Makefile
@@ -0,0 +1,16 @@
+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=luci-app-blueaudio
+PKG_VERSION:=1.0
+PKG_RELEASE:=1
+
+PKG_MAINTAINER:=Self
+PKG_LICENSE:=GPLv3
+
+LUCI_TITLE:=BlueALSA 蓝牙音频切换 (A2DP/HFP)
+LUCI_DEPENDS:=+bluez-alsa +bluez-daemon +dbus +kmod-bluetooth +kmod-usb-bluetooth
+LUCI_PKGARCH:=all
+
+include $(TOPDIR)/feeds/luci/luci.mk
+
diff --git a/feeds/pon_userspace/luci-app-blueaudio/root/etc/config/blueaudio b/feeds/pon_userspace/luci-app-blueaudio/root/etc/config/blueaudio
new file mode 100644
index 0000000..e278760
--- /dev/null
+++ b/feeds/pon_userspace/luci-app-blueaudio/root/etc/config/blueaudio
@@ -0,0 +1,3 @@
+config main
+    option profile 'a2dp'
+
diff --git a/feeds/pon_userspace/luci-app-blueaudio/root/etc/init.d/blueaudio b/feeds/pon_userspace/luci-app-blueaudio/root/etc/init.d/blueaudio
new file mode 100755
index 0000000..31781c0
--- /dev/null
+++ b/feeds/pon_userspace/luci-app-blueaudio/root/etc/init.d/blueaudio
@@ -0,0 +1,41 @@
+#!/bin/sh /etc/rc.common
+USE_PROCD=1
+START=99
+STOP=01
+
+start_service() {
+    local profile
+    config_load blueaudio
+    config_get profile main profile "a2dp"
+
+    procd_open_instance
+    procd_set_param command /usr/bin/bluealsad
+    if [ "$profile" = "hfp" ]; then
+        procd_append_param command -p a2dp-source -p a2dp-sink -p hfp-ag
+    else
+        procd_append_param command -p a2dp-source -p a2dp-sink
+    fi
+    procd_set_param respawn
+    procd_set_param stdout 1
+    procd_set_param stderr 1
+    procd_close_instance
+}
+
+service_triggers() {
+    procd_add_reload_trigger "blueaudio"
+}
+
diff --git a/feeds/pon_userspace/luci-app-blueaudio/root/usr/share/luci/controllers/blueaudio.lua b/feeds/pon_userspace/luci-app-blueaudio/root/usr/share/luci/controllers/blueaudio.lua
new file mode 100644
index 0000000..9124052
--- /dev/null
+++ b/feeds/pon_userspace/luci-app-blueaudio/root/usr/share/luci/controllers/blueaudio.lua
@@ -0,0 +1,12 @@
+module("luci.controller.blueaudio", package.seeall)
+function index()
+    entry({"admin", "services", "blueaudio"}, cbi("blueaudio"), _("Blue蓝牙音频"), 70)
+        .dependent = true
+        .icon = "bluetooth"
+end
+
diff --git a/feeds/pon_userspace/luci-app-blueaudio/root/usr/share/luci/i18n/zh-cn/blueaudio.po b/feeds/pon_userspace/luci-app-blueaudio/root/usr/share/luci/i18n/zh-cn/blueaudio.po
