From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Self <self@local>
Date: Thu, 13 Nov 2026 00:00:00 +0800
Subject: [PATCH 0004] add luci-app-camlive: v4l2+alsa hls live (video+audio)

Add luci page for ffmpeg hls live with v4l2 camera + alsa mic.
Keep compatible with luci-app-mjpg-streamer, no conflict.
Depends: ffmpeg, luci-base
---
 feeds/pon_userspace/luci-app-camlive/Makefile                                 | 34 +++++
 feeds/pon_userspace/luci-app-camlive/root/etc/init.d/camlive                 | 136 +++++++++++++++++
 feeds/pon_userspace/luci-app-camlive/root/etc/uci-defaults/99-camlive-defaults | 17 +++
 feeds/pon_userspace/luci-app-camlive/root/usr/share/luci/menu.d/luci-app-camlive.json | 11 ++
 feeds/pon_userspace/luci-app-camlive/root/www/luci-app-camlive/camlive.lua    | 320 +++++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 518 insertions(+)
 create mode 100644 feeds/pon_userspace/luci-app-camlive/Makefile
 create mode 100755 feeds/pon_userspace/luci-app-camlive/root/etc/init.d/camlive
 create mode 100644 feeds/pon_userspace/luci-app-camlive/root/etc/uci-defaults/99-camlive-defaults
 create mode 100644 feeds/pon_userspace/luci-app-camlive/root/usr/share/luci/menu.d/luci-app-camlive.json
 create mode 100644 feeds/pon_userspace/luci-app-camlive/root/www/luci-app-camlive/camlive.lua

diff --git a/feeds/pon_userspace/luci-app-camlive/Makefile b/feeds/pon_userspace/luci-app-camlive/Makefile
new file mode 100644
index 0000000..7b81244
--- /dev/null
+++ b/feeds/pon_userspace/luci-app-camlive/Makefile
@@ -0,0 +1,34 @@
+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=luci-app-camlive
+PKG_VERSION:=1.0
+PKG_RELEASE:=1
+
+PKG_MAINTAINER:=Self
+PKG_LICENSE:=GPLv3
+
+LUCI_TITLE:=Camera Live HLS (Video+Audio)
+LUCI_DESCRIPTION:=V4L2 camera + ALSA mic HLS live stream, compatible with mjpg-streamer
+LUCI_DEPENDS:=+luci-base +ffmpeg
+LUCI_PKGARCH:=all
+
+define Package/luci-app-camlive/conffiles
+/etc/config/camlive
+endef
+
+define Package/luci-app-camlive/install
+	$(INSTALL_DIR) $(1)/etc/init.d
+	$(INSTALL_BIN) ./root/etc/init.d/camlive $(1)/etc/init.d/camlive
+
+	$(INSTALL_DIR) $(1)/etc/uci-defaults
+	$(INSTALL_BIN) ./root/etc/uci-defaults/99-camlive-defaults $(1)/etc/uci-defaults/99-camlive-defaults
+
+	$(INSTALL_DIR) $(1)/usr/share/luci/menu.d
+	$(INSTALL_DATA) ./root/usr/share/luci/menu.d/luci-app-camlive.json $(1)/usr/share/luci/menu.d/luci-app-camlive.json
+
+	$(INSTALL_DIR) $(1)/www/luci-app-camlive
+	$(INSTALL_DATA) ./root/www/luci-app-camlive/camlive.lua $(1)/www/luci-app-camlive/camlive.lua
+
+	$(INSTALL_DIR) $(1)/www/camlive
+endef
+
+include $(TOPDIR)/feeds/luci/luci.mk
+
diff --git a/feeds/pon_userspace/luci-app-camlive/root/etc/init.d/camlive b/feeds/pon_userspace/luci-app-camlive/root/etc/init.d/camlive
new file mode 100755
index 0000000..8990088
--- /dev/null
+++ b/feeds/pon_userspace/luci-app-camlive/root/etc/init.d/camlive
@@ -0,0 +1,136 @@
+#!/bin/sh /etc/rc.common
+
+USE_PROCD=1
+START=96
+STOP=05
+
+CAMLIVE_ROOT="/www/camlive"
+
+clean_slice(){
+	rm -f ${CAMLIVE_ROOT}/*.ts ${CAMLIVE_ROOT}/stream.m3u8
+}
+
+camlive_start(){
+	config_load camlive
+	config_get enable global enable 0
+	[ "$enable" != "1" ] && return 0
+
+	config_get dev_video global dev_video "/dev/video0"
+	config_get dev_audio global dev_audio "default"
+	config_get res global res "640x480"
+	config_get fps global fps "15"
+	config_get auto_stop_mjpg global auto_stop_mjpg 1
+
+	[ ! -c "$dev_video" ] && return 1
+
+	# 可选自动停止mjpg-streamer，防止抢占v4l2
+	if [ "$auto_stop_mjpg" = "1" ]; then
+		/etc/init.d/mjpg-streamer stop 2>/dev/null
+	fi
+
+	mkdir -p ${CAMLIVE_ROOT}
+	clean_slice
+
+	procd_open_instance
+	procd_set_param command /usr/bin/ffmpeg \
+		-f v4l2 -framerate ${fps} -video_size ${res} -i ${dev_video} \
+		-f alsa -i ${dev_audio} \
+		-c:v libx264 -preset veryfast -crf 28 \
+		-c:a aac -b:a 64k \
+		-hls_time 2 -hls_list_size 6 -hls_flags delete_segments \
+		${CAMLIVE_ROOT}/stream.m3u8
+	procd_set_param respawn
+	procd_set_param stdout 1
+	procd_set_param stderr 1
+	procd_close_instance
+}
+
+camlive_stop(){
+	procd_stop
+	sleep 0.3
+	clean_slice
+}
+
+camlive_status(){
+	if procd list | grep -q camlive; then
+		echo "running"
+	else
+		echo "stopped"
+	fi
+}
+
+start_service() {
+	camlive_start
+}
+
+stop_service() {
+	camlive_stop
+}
+
+service_triggers() {
+	procd_add_reload_trigger "camlive"
+}
+
+reload_service() {
+	stop_service
+	start_service
+}
+
+action_list_video(){
+	ls /dev/video* 2>/dev/null
+}
+
+action_list_alsa(){
+	arecord -L 2>/dev/null
+}
+
+action_mjpg_status(){
+	if /etc/init.d/mjpg-streamer status >/dev/null 2>&1; then
+		echo "mjpg-streamer: running"
+	else
+		echo "mjpg-streamer: stopped"
+	fi
+}
+
+case "$1" in
+	status) camlive_status ;;
+	list_video) action_list_video ;;
+	list_alsa) action_list_alsa ;;
+	mjpg_status) action_mjpg_status ;;
+esac
+
+return 0
diff --git a/feeds/pon_userspace/luci-app-camlive/root/etc/uci-defaults/99-camlive-defaults b/feeds/pon_userspace/luci-app-camlive/root/etc/uci-defaults/99-camlive-defaults
new file mode 100644
index 0000000..2b11111
--- /dev/null
+++ b/feeds/pon_userspace/luci-app-camlive/root/etc/uci-defaults/99-camlive-defaults
@@ -0,0 +1,17 @@
+#!/bin/sh
+
+uci -q get camlive.global >/dev/null || {
+	uci set camlive.global=camlive
+	uci set camlive.global.enable=0
+	uci set camlive.global.dev_video="/dev/video0"
+	uci set camlive.global.dev_audio="default"
+	uci set camlive.global.res="640x480"
+	uci set camlive.global.fps="15"
+	uci set camlive.global.auto_stop_mjpg="1"
+	uci commit camlive
+}
+
+exit 0
diff --git a/feeds/pon_userspace/luci-app-camlive/root/usr/share/luci/menu.d/luci-app-camlive.json b/feeds/pon_userspace/luci-app-camlive/root/usr/share/luci/menu.d/luci-app-camlive.json
new file mode 100644
index 0000000..411111
--- /dev/null
+++ b/feeds/pon_userspace/luci-app-camlive/root/usr/share/luci/menu.d/luci-app-camlive.json
@@ -0,0 +1,11 @@
+{
+	"luci-app-camlive": {
+		"title": "摄像头音视频直播(HLS)",
+		"order": 91,
+		"action": {
+			"type": "view",
+			"path": "camlive"
+		},
+		"depends": { "acl": "luci-app-camlive" }
+	}
+}
diff --git a/feeds/pon_userspace/luci-app-camlive/root/www/luci-app-camlive/camlive.lua b/feeds/pon_userspace/luci-app-camlive/camlive.lua
new file mode 100644
index 0000000..4465555
--- /dev/null
+++ b/feeds/pon_userspace/luci-app-camlive/root/www/luci-app-camlive/camlive.lua
@@ -0,0 +1,320 @@
+local uci = require "luci.model.uci".cursor()
+local sys = require "luci.sys"
+local http = require "luci.http"
+local util = require "luci.util"
+
+local page = "camlive"
+local title = "摄像头音视频直播 HLS"
+
+http.header("Cache-Control", "no-cache")
+http.prepare_content("text/html; charset=utf-8")
+
+local function html_head()
+	print([[
+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<title>]]..title..[[</title>
+<link rel="stylesheet" href="/luci-static/bootstrap/cascade.css">
+<script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
+<style>
+.wrap{padding:15px;}
+.log{background:#111;color:#0f0;padding:8px;font-family:monospace;white-space:pre-wrap;max-height:200px;overflow:auto;}
+.player{max-width:100%;background:#000;}
+</style>
+</head>
+<body class="wrap">
+<h2>]]..title..[[</h2>
+]])
+end
+
+local function html_foot()
+print([[
+<script>
+var video = document.getElementById('video');
+var src = '/camlive/stream.m3u8';
+if (Hls.isSupported()) {
+	var hls = new Hls();
+	hls.loadSource(src);
+	hls.attachMedia(video);
+} else if (video.canPlayType('application/vnd.apple.mpegurl')) {
+	video.src = src;
+}
+</script>
+</body></html>
+]])
+end
+
+local function get_cfg()
+	local c = {}
+	c.enable = uci:get("camlive","global","enable") or "0"
+	c.dev_video = uci:get("camlive","global","dev_video") or "/dev/video0"
+	c.dev_audio = uci:get("camlive","global","dev_audio") or "default"
+	c.res = uci:get("camlive","global","res") or "640x480"
+	c.fps = uci:get("camlive","global","fps") or "15"
+	c.auto_stop_mjpg = uci:get("camlive","global","auto_stop_mjpg") or "1"
+	c.status = sys.exec("/etc/init.d/camlive status")
+	c.mjpg_status = sys.exec("/etc/init.d/camlive mjpg_status")
+	return c
+end
+
+local function save_cfg()
+	if http.formvalue("save") then
+		uci:set("camlive","global","enable", http.formvalue("enable") or "0")
+		uci:set("camlive","global","dev_video", http.formvalue("dev_video") or "/dev/video0")
+		uci:set("camlive","global","dev_audio", http.formvalue("dev_audio") or "default")
+		uci:set("camlive","global","res", http.formvalue("res") or "640x480")
+		uci:set("camlive","global","fps", http.formvalue("fps") or "15")
+		uci:set("camlive","global","auto_stop_mjpg", http.formvalue("auto_stop_mjpg") or "1")
+		uci:commit("camlive")
+	end
+end
+
+local function action_run()
+	local act = http.formvalue("action")
+	local out = ""
+	if act == "start" then
+		sys.exec("/etc/init.d/camlive start")
+		out = "Started"
+	elseif act == "stop" then
+		sys.exec("/etc/init.d/camlive stop")
+		out = "Stopped"
+	elseif act == "list_video" then
+		out = sys.exec("/etc/init.d/camlive list_video")
+	elseif act == "list_alsa" then
+		out = sys.exec("/etc/init.d/camlive list_alsa")
+	end
+	return out
+end
+
+save_cfg()
+local action_out = action_run()
+local cfg = get_cfg()
+local ip = sys.exec("uci get network.lan.ipaddr") or "192.168.1.1"
+
+html_head()
+print([[
+<div class="alert alert-info">
+]]..cfg.mjpg_status..[[ &nbsp;&nbsp;
+说明：开启直播时，可自动停止mjpg-streamer避免抢占摄像头；关闭后可手动再开mjpg-streamer。
+</div>
+
+<video id="video" class="player" controls autoplay muted></video>
+
+<form method="post">
+<fieldset>
+<legend>基础配置</legend>
+<div class="cbi-row">
+<label>开机自动启用：</label>
+<input type="checkbox" name="enable" value="1" ]]..(cfg.enable=="1" and "checked" or "")..[[>
+</div>
+<div class="cbi-row">
+<label>视频设备 /dev/video*：</label>
+<input type="text" name="dev_video" value="]]..cfg.dev_video..[[">
+<button type="submit" name="action" value="list_video">刷新列表</button>
+</div>
+<div class="cbi-row">
+<label>ALSA音频输入设备：</label>
+<input type="text" name="dev_audio" value="]]..cfg.dev_audio..[[">
+<button type="submit" name="action" value="list_alsa">刷新声卡</button>
+</div>
+<div class="cbi-row">
+<label>分辨率：</label>
+<select name="res">
+<option value="640x480" ]]..(cfg.res=="640x480" and "selected" or "")..[[>640x480</option>
+<option value="1280x720" ]]..(cfg.res=="1280x720" and "selected" or "")..[[>720P</option>
+<option value="1920x1080" ]]..(cfg.res=="1920x1080" and "selected" or "")..[[>1080P</option>
+</select>
+</div>
+<div class="cbi-row">
+<label>帧率：</label>
+<input type="number" name="fps" value="]]..cfg.fps..[[" min="5" max="30">
+</div>
+<div class="cbi-row">
+<label>启动时自动停止mjpg-streamer：</label>
+<input type="checkbox" name="auto_stop_mjpg" value="1" ]]..(cfg.auto_stop_mjpg=="1" and "checked" or "")..[[>
+</div>
+<div class="cbi-row">
+<input type="submit" name="save" value="保存配置" class="btn cbi-button-action">
+</div>
+</fieldset>
+</form>
+
+<fieldset>
+<legend>控制</legend>
+<p>当前直播状态：<strong>]]..cfg.status..[[</strong></p>
+<form method="post">
+<button type="submit" name="action" value="start" class="btn cbi-button-positive">启动HLS直播</button>
+<button type="submit" name="action" value="stop" class="btn cbi-button-negative">停止HLS直播</button>
+</form>
+</fieldset>
+
+<fieldset>
+<legend>输出日志</legend>
+<div class="log">]]..action_out..[[</div>
+</fieldset>
+
+<div class="alert alert-warning">
+注意：ffmpeg编码占用CPU较高，720P@15帧在AN7581比较稳妥；<br>
+浏览器需要支持HLS；部分浏览器需要https才能正常播放音频。
+</div>
+]])
+
+html_foot()
