#!/bin/sh /etc/rc.common
USE_PROCD=1
START=97
STOP=01

start_service() {
    config_load camlive
    config_get enable main enable '0'
    config_get res main resolution '640x480'
    config_get fps main fps '15'
    config_get rtsp_port main rtsp_port '8554'
    [ "$enable" != "1" ] && return 0

    procd_open_instance
    procd_set_param command /usr/bin/camlive
    procd_append_param command -r "$res"
    procd_append_param command -f "$fps"
    procd_append_param command -p "$rtsp_port"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "camlive"
}
