#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

CONF=/etc/go2rtc/go2rtc.yaml

start_service() {
	local api
	# 允许在 /etc/config 里不改 yaml 的情况下换 API 端口（可选）
	api=$(uci -q get go2rtc.main.api || true)

	procd_open_instance
	procd_set_param command /usr/bin/go2rtc -c "$CONF"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1024 1024"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger go2rtc
}
