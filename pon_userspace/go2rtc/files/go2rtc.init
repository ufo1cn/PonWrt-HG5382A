#!/bin/sh /etc/rc.common
#
# go2rtc 由 /etc/config/go2rtc 驱动：启动时把 UCI 配置生成 /var/etc/go2rtc.yaml，
# 这样 LuCI 里改端口/流地址即可，不需要手工编辑 yaml（也不会和 yaml 打架）。
#
START=95
STOP=10
USE_PROCD=1

GEN=/var/etc/go2rtc.yaml

gen_config() {
	local api rtsp webrtc cam transcode mic spk

	api=$(uci -q get go2rtc.main.api_port);      [ -z "$api" ] && api=1984
	rtsp=$(uci -q get go2rtc.main.rtsp_port);    [ -z "$rtsp" ] && rtsp=8554
	webrtc=$(uci -q get go2rtc.main.webrtc_port); [ -z "$webrtc" ] && webrtc=8555
	cam=$(uci -q get go2rtc.main.camera);        [ -z "$cam" ] && cam="http://127.0.0.1:8556/stream"
	transcode=$(uci -q get go2rtc.main.transcode)
	mic=$(uci -q get go2rtc.main.mic_device)
	spk=$(uci -q get go2rtc.main.speaker_device)

	mkdir -p /var/etc
	{
		echo "log:"
		echo "  level: info"
		echo "api:"
		echo "  listen: \":$api\""
		echo "  origin: \"*\""
		echo "rtsp:"
		echo "  listen: \":$rtsp\""
		echo "webrtc:"
		echo "  listen: \":$webrtc\""
		echo "ffmpeg:"
		echo "  bin: ffmpeg"
		echo "streams:"
		echo "  camera: \"$cam\""
		if [ "$transcode" = "1" ]; then
			echo "  camera_h264: \"ffmpeg:camera#video=h264#audio=copy\""
		fi
		if [ -n "$mic" ]; then
			echo "  microphone: \"alsa:$mic\""
		fi
		if [ -n "$spk" ]; then
			echo "  speaker: \"alsa:$spk\""
		fi
	} > $GEN
}

start_service() {
	local enabled
	enabled=$(uci -q get go2rtc.main.enabled)
	if [ "$enabled" = "0" ]; then
		logger -t go2rtc "已禁用（uci go2rtc.main.enabled=0），不启动"
		return 0
	fi

	gen_config

	procd_open_instance
	procd_set_param command /usr/bin/go2rtc -c $GEN
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1024 1024"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger go2rtc
}

reload_service() {
	stop
	start
}
