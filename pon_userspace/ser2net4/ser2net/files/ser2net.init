#!/bin/sh /etc/rc.common
USE_PROCD=1
START=90
STOP=10

yaml_out="/etc/ser2net.yaml"
template="/etc/ser2net.yaml.template"

uci2yaml() {
    rm -f "$yaml_out"
    echo "version: 4.0" > "$yaml_out"

    local section
    config_load ser2net
    config_foreach handle_port port

    handle_port() {
        local device baud databits stopbits parity tcp_mode port timeout enable
        config_get device "$1" device
        config_get baud "$1" baud 9600
        config_get databits "$1" databits 8
        config_get stopbits "$1" stopbits 1
        config_get parity "$1" parity none
        config_get tcp_mode "$1" tcp_mode raw
        config_get port "$1" port 2000
        config_get timeout "$1" timeout 0
        config_get enable "$1" enable 1

        [ "$enable" != "1" ] && return 0

        cat >> "$yaml_out" <<EOF
- name: port_${port}
  connection: ${tcp_mode}($port)
  serialdev: serialdev,${device},${baud},${databits},${stopbits},${parity}
  timeout: ${timeout}
EOF
    }
}

start_service() {
    uci2yaml
    procd_open_instance
    procd_set_param command /usr/bin/ser2net -c "$yaml_out"
    procd_set_param respawn
    procd_close_instance
}

reload_service() {
    stop
    start
}
