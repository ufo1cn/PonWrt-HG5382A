#!/bin/sh /etc/rc.common
USE_PROCD=1
START=98
STOP=01

start_service() {
    config_load btsp
    config_get enable main enable '0'
    config_get mac main mac
    config_get baud main baud '9600'
    config_get port main port '5001'
    [ "$enable" != "1" ] && return 0

    procd_open_instance
    procd_set_param command /usr/bin/btsp
    procd_append_param command -m "$mac"
    procd_append_param command -b "$baud"
    procd_append_param command -p "$port"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "btsp"
}
